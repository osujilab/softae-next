# NOTE: git has no trailing comments. A '#' only starts a comment at the
# start of a line, so every comment here sits on its own line.

# ─── Virtual environment ──────────────────────────────────────────────
.venv/

# ─── Python caches & tooling state ────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# ─── Build artifacts ──────────────────────────────────────────────────
*.egg-info/
dist/
build/
*.so
*.dll
# mkdocs build output (`mkdocs build`)
site/

# ─── Per-machine editor / agent state ─────────────────────────────────
# Local settings and agent memory; not portable between machines.
.claude/
.vscode/
# assumes sibling folders (../educational_modules, ...) no clone reproduces
softae-next.code-workspace

# ─── Experimental data & run output ───────────────────────────────────
# Real experimental results, instrument logs and plot dumps. These are
# lab records, not source; they live in the DataStore, not in git.
# catalogs (tasks.toml, recipes.toml) + chemicals/solutions CSVs
data/
# real experimental results DB at repo root
softae_results.db
# workflow run logs (*.jsonl)
logs/
# ms_plot_*.txt and other run dumps
output/
# data exports; no CSV outside data/ exists today
*.csv
# repo-root only: a test artifact from a DataStore built on a relative path
# instead of tmp_path. Ignored so it cannot be committed by accident.
/softae_data/

# ─── Documentation: private by default ────────────────────────────────
# Everything under docs/ is ignored, then the public surface is
# re-included explicitly. New docs are therefore private unless someone
# deliberately adds a negation below.
#
# This deliberately covers the live multi-session coordination transcript
# `docs/SubAgent docs/SESSION_MAIL.md` and `docs/SubAgent docs/TASKS.md`,
# which must NEVER be committed, along with all working specs, roadmaps
# and progress logs.
docs/*
!docs/api/
!docs/USER_GUIDE.md
!docs/architecture.md
# the mkdocs homepage; without it a clone's site root is a 404
!docs/index.md

# ─── Machine-local session coordination ───────────────────────────────
# The ownership map `docs/SubAgent docs/OWNERSHIP.toml` is already private
# under the `docs/*` rule above: it is per-working-tree session state, and a
# fresh clone has no sessions to describe. Its reader and that reader's tests
# are the same category of thing, so they travel with the map rather than with
# the repository. Anchored to the repo root so they match nothing else.
/tools/whose.py
/tests/test_whose.py
